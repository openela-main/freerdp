From 6829c8935e41d999616d0e86af228f14fde6d7a0 Mon Sep 17 00:00:00 2001
From: Ondrej Holy <oholy@redhat.com>
Date: Tue, 27 Oct 2026 10:00:00 +0000
Subject: [PATCH] [codec,dsp] fix mp3 buffer use

Backport of commit 1248aa1e4e00dfb84395d7649788035d4de80b4a.

Adapted for 2.11.x: uses `context->format` instead of
`context->common.format` and `Stream_Buffer` casts instead of
`Stream_BufferAs`. All three upstream expression changes are preserved.
---
 libfreerdp/codec/dsp.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/libfreerdp/codec/dsp.c b/libfreerdp/codec/dsp.c
index 29362d559..6e3f9d618 100644
--- a/libfreerdp/codec/dsp.c
+++ b/libfreerdp/codec/dsp.c
@@ -529,13 +529,13 @@ static BOOL freerdp_dsp_decode_mp3(FREERDP_DSP_CONTEXT* context, const BYTE* src
 	if (!valid_mp3_format(context))
 		return FALSE;
 
-	buffer_size = 2 * context->format.nChannels * context->format.nSamplesPerSec;
+	buffer_size = 2ull * context->format.nChannels * context->format.nSamplesPerSec;
 
-	if (!Stream_EnsureCapacity(context->buffer, 2 * buffer_size))
+	if (!Stream_EnsureCapacity(context->buffer, 2ull * buffer_size))
 		return FALSE;
 
 	pcm_l = (short*)Stream_Buffer(context->buffer);
-	pcm_r = (short*)Stream_Buffer(context->buffer) + buffer_size;
+	pcm_r = (short*)Stream_Buffer(context->buffer) + (buffer_size / sizeof(short));
 	rc = hip_decode(context->hip, (unsigned char*)/* API is not modifying content */ src, size,
 	                pcm_l, pcm_r);
 
