From 49ed624febdf64c6ffb6c7a93c48c7b260cea1d7 Mon Sep 17 00:00:00 2001
From: Ondrej Holy <oholy@redhat.com>
Date: Tue, 27 Oct 2026 10:00:00 +0000
Subject: [PATCH] [memory] prefer winpr_aligned_calloc

Backport of commit 2e59cd87918f776dbacf791bd960582b8662c88b.

Adapted for 2.11.x: only the `libfreerdp/codec/progressive.c` changes
relevant to the CVE are included. The 2.x code has no
`winpr_aligned_calloc`, so `winpr_aligned_calloc` is replaced by
`_aligned_malloc` followed by a NULL-guarded `memset` of the `tile->sign`
and `tile->current` buffers.
---
 libfreerdp/codec/progressive.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/libfreerdp/codec/progressive.c b/libfreerdp/codec/progressive.c
index bbcc92100..35e1cea8d 100644
--- a/libfreerdp/codec/progressive.c
+++ b/libfreerdp/codec/progressive.c
@@ -453,11 +453,15 @@ static INLINE BOOL progressive_tile_allocate(RFX_PROGRESSIVE_TILE* tile)
 	{
 		size_t signLen = (8192 + 32) * 3;
 		tile->sign = (BYTE*)_aligned_malloc(signLen, 16);
+		if (tile->sign)
+			memset(tile->sign, 0, signLen);
 	}
 
 	{
 		size_t currentLen = (8192 + 32) * 3;
 		tile->current = (BYTE*)_aligned_malloc(currentLen, 16);
+		if (tile->current)
+			memset(tile->current, 0, currentLen);
 	}
 
 	rc = tile->data && tile->sign && tile->current;
