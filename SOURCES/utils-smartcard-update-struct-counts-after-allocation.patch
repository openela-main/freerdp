 		return ERROR_INVALID_DATA;
 	Stream_Read_INT32(s, call->fmszReadersIsNULL); /* fmszReadersIsNULL (4 bytes) */
@@ -1980,9 +1980,10 @@ LONG smartcard_unpack_list_readers_call(wStream* s, ListReaders_Call* call, BOOL
 
 	if (mszGroupsNdrPtr)
 	{
-		status = smartcard_ndr_read(s, &call->mszGroups, call->cBytes, 1, NDR_PTR_SIMPLE);
+		status = smartcard_ndr_read(s, &call->mszGroups, cBytes, 1, NDR_PTR_SIMPLE);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cBytes = cBytes;
 	}
 
 	smartcard_trace_list_readers_call(call, unicode);
@@ -2388,7 +2389,7 @@ LONG smartcard_unpack_get_status_change_a_call(wStream* s, GetStatusChangeA_Call
 		return STATUS_BUFFER_TOO_SMALL;
 
