From 78d2c45c46170ea11758bd4311f7a0bb4a4361ba Mon Sep 17 00:00:00 2001
From: Armin Novak <armin.novak@thincast.com>
Date: Tue, 7 Jul 2026 09:20:54 +0200
Subject: [PATCH] [utils,smartcard] update struct counts after allocation

---
 libfreerdp/utils/smartcard_call.c | 45 ++++++++++++---------
 libfreerdp/utils/smartcard_pack.c | 67 ++++++++++++++++++-------------
 2 files changed, 67 insertions(+), 45 deletions(-)

diff --git a/libfreerdp/utils/smartcard_call.c b/libfreerdp/utils/smartcard_call.c
index 9a3b3916d..83e703869 100644
--- a/libfreerdp/utils/smartcard_call.c
+++ b/libfreerdp/utils/smartcard_call.c
@@ -607,15 +607,16 @@ static LONG smartcard_LocateCardsA_Call(scard_call_context* smartcard, wStream*
 	ret.ReturnCode = wrap(smartcard, SCardLocateCardsA, operation->hContext, call->mszCards,
 	                      call->rgReaderStates, call->cReaders);
 	scard_log_status_error(TAG, "SCardLocateCardsA", ret.ReturnCode);
-	ret.cReaders = call->cReaders;
 	ret.rgReaderStates = NULL;
 
-	if (ret.cReaders > 0)
+	if (call->cReaders > 0)
 	{
-		ret.rgReaderStates = (ReaderState_Return*)calloc(ret.cReaders, sizeof(ReaderState_Return));
+		ret.rgReaderStates =
+		    (ReaderState_Return*)calloc(call->cReaders, sizeof(ReaderState_Return));
 
 		if (!ret.rgReaderStates)
 			return STATUS_NO_MEMORY;
+		ret.cReaders = call->cReaders;
 	}
 
 	for (UINT32 x = 0; x < ret.cReaders; x++)
@@ -650,15 +651,16 @@ static LONG smartcard_LocateCardsW_Call(scard_call_context* smartcard, wStream*
 	ret.ReturnCode = wrap(smartcard, SCardLocateCardsW, operation->hContext, call->mszCards,
 	                      call->rgReaderStates, call->cReaders);
 	scard_log_status_error(TAG, "SCardLocateCardsW", ret.ReturnCode);
-	ret.cReaders = call->cReaders;
 	ret.rgReaderStates = NULL;
 
-	if (ret.cReaders > 0)
+	if (call->cReaders > 0)
 	{
-		ret.rgReaderStates = (ReaderState_Return*)calloc(ret.cReaders, sizeof(ReaderState_Return));
+		ret.rgReaderStates =
+		    (ReaderState_Return*)calloc(call->cReaders, sizeof(ReaderState_Return));
 
 		if (!ret.rgReaderStates)
 			return STATUS_NO_MEMORY;
+		ret.cReaders = call->cReaders;
 	}
 
 	for (UINT32 x = 0; x < ret.cReaders; x++)
@@ -695,13 +697,13 @@ static LONG smartcard_ReadCacheA_Call(scard_call_context* smartcard, wStream* ou
 
 	if (!call->Common.fPbDataIsNULL)
 	{
-		ret.cbDataLen = call->Common.cbDataLen;
 		if (!autoalloc)
 		{
-			ret.pbData = malloc(ret.cbDataLen);
+			ret.pbData = malloc(call->Common.cbDataLen);
 			if (!ret.pbData)
 				return SCARD_F_INTERNAL_ERROR;
 		}
+		ret.cbDataLen = call->Common.cbDataLen;
 	}
 
 	if (autoalloc)
@@ -907,11 +909,13 @@ static LONG smartcard_GetStatusChangeA_Call(scard_call_context* smartcard, wStre
 
 	if (call->cReaders > 0)
 	{
-		ret.cReaders = call->cReaders;
 		rgReaderStates = calloc(ret.cReaders, sizeof(SCARD_READERSTATEA));
-		ret.rgReaderStates = (ReaderState_Return*)calloc(ret.cReaders, sizeof(ReaderState_Return));
+		ret.rgReaderStates =
+		    (ReaderState_Return*)calloc(call->cReaders, sizeof(ReaderState_Return));
 		if (!rgReaderStates || !ret.rgReaderStates)
 			goto fail;
+
+		ret.cReaders = call->cReaders;
 	}
 
 	for (UINT32 x = 0; x < MAX(1, dwTimeOut);)
@@ -969,11 +973,13 @@ static LONG smartcard_GetStatusChangeW_Call(scard_call_context* smartcard, wStre
 
 	if (call->cReaders > 0)
 	{
-		ret.cReaders = call->cReaders;
 		rgReaderStates = calloc(ret.cReaders, sizeof(SCARD_READERSTATEW));
-		ret.rgReaderStates = (ReaderState_Return*)calloc(ret.cReaders, sizeof(ReaderState_Return));
+		ret.rgReaderStates =
+		    (ReaderState_Return*)calloc(call->cReaders, sizeof(ReaderState_Return));
 		if (!rgReaderStates || !ret.rgReaderStates)
 			goto fail;
+
+		ret.cReaders = call->cReaders;
 	}
 
 	for (UINT32 x = 0; x < MAX(1, dwTimeOut);)
@@ -1330,11 +1336,12 @@ static LONG smartcard_Transmit_Call(scard_call_context* smartcard, wStream* out,
 		if (call->cbRecvLength >= 66560)
 			call->cbRecvLength = 66560;
 
-		ret.cbRecvLength = call->cbRecvLength;
-		ret.pbRecvBuffer = (BYTE*)malloc(ret.cbRecvLength);
+		const UINT32 cbRecvLength = call->cbRecvLength;
+		ret.pbRecvBuffer = (BYTE*)malloc(cbRecvLength);
 
 		if (!ret.pbRecvBuffer)
 			return STATUS_NO_MEMORY;
+		ret.cbRecvLength = cbRecvLength;
 	}
 
 	ret.pioRecvPci = call->pioRecvPci;
@@ -1364,11 +1371,11 @@ static LONG smartcard_Control_Call(scard_call_context* smartcard, wStream* out,
 	WINPR_ASSERT(operation);
 
 	call = &operation->call.control;
-	ret.cbOutBufferSize = call->cbOutBufferSize;
 	ret.pvOutBuffer = (BYTE*)malloc(call->cbOutBufferSize);
 
 	if (!ret.pvOutBuffer)
 		return SCARD_E_NO_MEMORY;
+	ret.cbOutBufferSize = call->cbOutBufferSize;
 
 	ret.ReturnCode =
 	    wrap(smartcard, SCardControl, operation->hCard, call->dwControlCode, call->pvInBuffer,
@@ -1515,11 +1522,11 @@ static LONG smartcard_LocateCardsByATRA_Call(scard_call_context* smartcard, wStr
 		}
 	}
 
-	ret.cReaders = call->cReaders;
 	ret.rgReaderStates = NULL;
 
-	if (ret.cReaders > 0)
-		ret.rgReaderStates = (ReaderState_Return*)calloc(ret.cReaders, sizeof(ReaderState_Return));
+	if (call->cReaders > 0)
+		ret.rgReaderStates =
+		    (ReaderState_Return*)calloc(call->cReaders, sizeof(ReaderState_Return));
 
 	if (!ret.rgReaderStates)
 	{
@@ -1527,6 +1534,8 @@ static LONG smartcard_LocateCardsByATRA_Call(scard_call_context* smartcard, wStr
 		return STATUS_NO_MEMORY;
 	}
 
+	ret.cReaders = call->cReaders;
+
 	for (UINT32 i = 0; i < ret.cReaders; i++)
 	{
 		state = &states[i];
diff --git a/libfreerdp/utils/smartcard_pack.c b/libfreerdp/utils/smartcard_pack.c
index 52165def4..a76d896e1 100644
--- a/libfreerdp/utils/smartcard_pack.c
+++ b/libfreerdp/utils/smartcard_pack.c
@@ -1968,7 +1968,7 @@ LONG smartcard_unpack_list_readers_call(wStream* s, ListReaders_Call* call, BOOL
 	if (!Stream_CheckAndLogRequiredLength(TAG, s, 16))
 		return STATUS_BUFFER_TOO_SMALL;
 
-	Stream_Read_UINT32(s, call->cBytes); /* cBytes (4 bytes) */
+	const UINT32 cBytes = Stream_Get_UINT32(s); /* cBytes (4 bytes) */
