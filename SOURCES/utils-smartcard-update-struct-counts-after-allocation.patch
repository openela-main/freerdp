@@ -3405,7 +3416,7 @@ LONG smartcard_unpack_write_cache_a_call(wStream* s, WriteCacheA_Call* call)
 		return STATUS_BUFFER_TOO_SMALL;
 
 	Stream_Read_UINT32(s, call->Common.FreshnessCounter);
-	Stream_Read_UINT32(s, call->Common.cbDataLen);
+	const UINT32 cbDataLen = Stream_Get_UINT32(s);
 
 	if (!smartcard_ndr_pointer_read(s, &index, &pbDataNdrPtr))
 		return ERROR_INVALID_DATA;
@@ -3435,9 +3446,10 @@ LONG smartcard_unpack_write_cache_a_call(wStream* s, WriteCacheA_Call* call)
 	if (pbDataNdrPtr)
 	{
 		status =
-		    smartcard_ndr_read(s, &call->Common.pbData, call->Common.cbDataLen, 1, NDR_PTR_SIMPLE);
+		    smartcard_ndr_read(s, &call->Common.pbData, cbDataLen, 1, NDR_PTR_SIMPLE);
