-	Stream_Read_UINT32(s, call->cReaders);  /* cReaders (4 bytes) */
+	const DWORD cReaders = Stream_Get_UINT32(s); /* cReaders (4 bytes) */
 	if (!smartcard_ndr_pointer_read(s, &index, &ndrPtr))
 		return ERROR_INVALID_DATA;
 
@@ -2398,9 +2399,10 @@ LONG smartcard_unpack_get_status_change_a_call(wStream* s, GetStatusChangeA_Call
 
 	if (ndrPtr)
 	{
-		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, call->cReaders, &index);
+		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, cReaders, &index);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cReaders = cReaders;
 	}
 
 	smartcard_trace_get_status_change_a_call(call);
@@ -2424,7 +2426,7 @@ LONG smartcard_unpack_get_status_change_w_call(wStream* s, GetStatusChangeW_Call
 		return STATUS_BUFFER_TOO_SMALL;
 
 	Stream_Read_UINT32(s, call->dwTimeOut); /* dwTimeOut (4 bytes) */
-	Stream_Read_UINT32(s, call->cReaders);  /* cReaders (4 bytes) */
+	const DWORD cReaders = Stream_Get_UINT32(s); /* cReaders (4 bytes) */
 	if (!smartcard_ndr_pointer_read(s, &index, &ndrPtr))
 		return ERROR_INVALID_DATA;
 
@@ -2434,9 +2436,10 @@ LONG smartcard_unpack_get_status_change_w_call(wStream* s, GetStatusChangeW_Call
 
 	if (ndrPtr)
 	{
-		status = smartcard_unpack_reader_state_w(s, &call->rgReaderStates, call->cReaders, &index);
+		status = smartcard_unpack_reader_state_w(s, &call->rgReaderStates, cReaders, &index);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cReaders = cReaders;
 	}
 
 	smartcard_trace_get_status_change_w_call(call);
@@ -2669,7 +2672,7 @@ LONG smartcard_unpack_control_call(wStream* s, Control_Call* call)
 		return STATUS_BUFFER_TOO_SMALL;
 
 	Stream_Read_UINT32(s, call->dwControlCode);                    /* dwControlCode (4 bytes) */
-	Stream_Read_UINT32(s, call->cbInBufferSize);                   /* cbInBufferSize (4 bytes) */
+	const UINT32 cbInBufferSize = Stream_Get_UINT32(s);            /* cbInBufferSize (4 bytes) */
 	if (!smartcard_ndr_pointer_read(s, &index, &pvInBufferNdrPtr)) /* pvInBufferNdrPtr (4 bytes) */
 		return ERROR_INVALID_DATA;
 	Stream_Read_INT32(s, call->fpvOutBufferIsNULL); /* fpvOutBufferIsNULL (4 bytes) */
@@ -2684,9 +2687,10 @@ LONG smartcard_unpack_control_call(wStream* s, Control_Call* call)
 
 	if (pvInBufferNdrPtr)
 	{
-		status = smartcard_ndr_read(s, &call->pvInBuffer, call->cbInBufferSize, 1, NDR_PTR_SIMPLE);
+		status = smartcard_ndr_read(s, &call->pvInBuffer, cbInBufferSize, 1, NDR_PTR_SIMPLE);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cbInBufferSize = cbInBufferSize;
 	}
 
 	smartcard_trace_control_call(call);
@@ -2752,7 +2756,7 @@ LONG smartcard_unpack_transmit_call(wStream* s, Transmit_Call* call)
 	                                &pbExtraBytesNdrPtr)) /* pbExtraBytesNdrPtr (4 bytes) */
 		return ERROR_INVALID_DATA;
 
-	Stream_Read_UINT32(s, call->cbSendLength); /* cbSendLength (4 bytes) */
+	const UINT32 cbSendLength = Stream_Get_UINT32(s); /* cbSendLength (4 bytes) */
 	if (!smartcard_ndr_pointer_read(s, &index,
 	                                &pbSendBufferNdrPtr)) /* pbSendBufferNdrPtr (4 bytes) */
 		return ERROR_INVALID_DATA;
@@ -2771,7 +2775,7 @@ LONG smartcard_unpack_transmit_call(wStream* s, Transmit_Call* call)
 		return STATUS_INVALID_PARAMETER;
 	}
 
-	if (call->cbSendLength > 66560)
+	if (cbSendLength > 66560)
 	{
 		WLog_WARN(TAG, "Transmit_Call cbSendLength is out of bounds: %" PRIu32 " (max: 66560)",
 		          ioSendPci.cbExtraBytes);
@@ -2835,9 +2839,10 @@ LONG smartcard_unpack_transmit_call(wStream* s, Transmit_Call* call)
 
 	if (pbSendBufferNdrPtr)
 	{
-		status = smartcard_ndr_read(s, &call->pbSendBuffer, call->cbSendLength, 1, NDR_PTR_SIMPLE);
+		status = smartcard_ndr_read(s, &call->pbSendBuffer, cbSendLength, 1, NDR_PTR_SIMPLE);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cbSendLength = cbSendLength;
 	}
 
 	if (pioRecvPciNdrPtr)
@@ -2991,7 +2996,7 @@ LONG smartcard_unpack_locate_cards_by_atr_a_call(wStream* s, LocateCardsByATRA_C
 	Stream_Read_UINT32(s, call->cAtrs);
 	if (!smartcard_ndr_pointer_read(s, &index, &rgAtrMasksNdrPtr))
 		return ERROR_INVALID_DATA;
-	Stream_Read_UINT32(s, call->cReaders); /* cReaders (4 bytes) */
+	const DWORD cReaders = Stream_Get_UINT32(s); /* cReaders (4 bytes) */
 	if (!smartcard_ndr_pointer_read(s, &index, &rgReaderStatesNdrPtr))
 		return ERROR_INVALID_DATA;
 
@@ -3017,9 +3022,10 @@ LONG smartcard_unpack_locate_cards_by_atr_a_call(wStream* s, LocateCardsByATRA_C
 
 	if (rgReaderStatesNdrPtr)
 	{
-		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, call->cReaders, &index);
+		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, cReaders, &index);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cReaders = cReaders;
 	}
 
 	smartcard_trace_locate_cards_by_atr_a_call(call);
@@ -3115,11 +3121,11 @@ LONG smartcard_unpack_locate_cards_a_call(wStream* s, LocateCardsA_Call* call)
 	if (!Stream_CheckAndLogRequiredLength(TAG, s, 16))
 		return STATUS_BUFFER_TOO_SMALL;
 
-	Stream_Read_UINT32(s, call->cBytes);
+	const UINT32 cBytes = Stream_Get_UINT32(s);
 	if (!smartcard_ndr_pointer_read(s, &index, &sz1NdrPtr))
 		return ERROR_INVALID_DATA;
 
-	Stream_Read_UINT32(s, call->cReaders);
+	const DWORD cReaders = Stream_Get_UINT32(s);
 	if (!smartcard_ndr_pointer_read(s, &index, &sz2NdrPtr))
 		return ERROR_INVALID_DATA;
 
@@ -3130,15 +3136,17 @@ LONG smartcard_unpack_locate_cards_a_call(wStream* s, LocateCardsA_Call* call)
 	if (sz1NdrPtr)
 	{
 		status =
-		    smartcard_ndr_read_fixed_string_a(s, &call->mszCards, call->cBytes, NDR_PTR_SIMPLE);
+		    smartcard_ndr_read_fixed_string_a(s, &call->mszCards, cBytes, NDR_PTR_SIMPLE);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cBytes = cBytes;
 	}
 	if (sz2NdrPtr)
 	{
-		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, call->cReaders, &index);
+		status = smartcard_unpack_reader_state_a(s, &call->rgReaderStates, cReaders, &index);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cReaders = cReaders;
 	}
 	smartcard_trace_locate_cards_a_call(call);
 	return SCARD_S_SUCCESS;
@@ -3159,11 +3167,11 @@ LONG smartcard_unpack_locate_cards_w_call(wStream* s, LocateCardsW_Call* call)
 	if (!Stream_CheckAndLogRequiredLength(TAG, s, 16))
 		return STATUS_BUFFER_TOO_SMALL;
 
-	Stream_Read_UINT32(s, call->cBytes);
+	const UINT32 cBytes = Stream_Get_UINT32(s);
 	if (!smartcard_ndr_pointer_read(s, &index, &sz1NdrPtr))
 		return ERROR_INVALID_DATA;
 
-	Stream_Read_UINT32(s, call->cReaders);
+	const DWORD cReaders = Stream_Get_UINT32(s);
 	if (!smartcard_ndr_pointer_read(s, &index, &sz2NdrPtr))
 		return ERROR_INVALID_DATA;
 
@@ -3174,15 +3182,17 @@ LONG smartcard_unpack_locate_cards_w_call(wStream* s, LocateCardsW_Call* call)
 	if (sz1NdrPtr)
 	{
 		status =
-		    smartcard_ndr_read_fixed_string_w(s, &call->mszCards, call->cBytes, NDR_PTR_SIMPLE);
+		    smartcard_ndr_read_fixed_string_w(s, &call->mszCards, cBytes, NDR_PTR_SIMPLE);
 		if (status != SCARD_S_SUCCESS)
 			return status;
+		call->cBytes = cBytes;
 	}
 	if (sz2NdrPtr)
 	{
-		status = smartcard_unpack_reader_state_w(s, &call->rgReaderStates, call->cReaders, &index);
+		status = smartcard_unpack_reader_state_w(s, &call->rgReaderStates, cReaders, &index);
 		if (status != SCARD_S_SUCCESS)
