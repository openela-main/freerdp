From 0a81e99ecce8e4796a5862cf5f830a236070c15a Mon Sep 17 00:00:00 2001
From: Armin Novak <armin.novak@thincast.com>
Date: Mon, 24 Aug 2026 10:31:03 +0200
Subject: [PATCH] [core,server] lock dynamic channel list while parsing

---
 libfreerdp/core/server.c | 202 +++++++++++++++++++++------------------
 1 file changed, 110 insertions(+), 92 deletions(-)

diff --git a/libfreerdp/core/server.c b/libfreerdp/core/server.c
index 8c5a21343..9b5c9a860 100644
--- a/libfreerdp/core/server.c
+++ b/libfreerdp/core/server.c
@@ -264,120 +264,138 @@ static void wts_read_drdynvc_close_response(rdpPeerChannel* channel)
 	MessageQueue_PostQuit(channel->queue, 0);
 }
 
-static BOOL wts_read_drdynvc_pdu(rdpPeerChannel* channel)
+static BOOL wts_read_drdynvc_pdu_ready_guarded(rdpPeerChannel* channel, UINT8 Cmd, UINT8 Sp,
+                                               UINT32 ChannelId, rdpPeerChannel* dvc,
+                                               UINT32 length)
 {
-	UINT8 Cmd = 0;
-	UINT8 Sp = 0;
-	UINT8 cbChId = 0;
-	UINT32 ChannelId = 0;
-	rdpPeerChannel* dvc = NULL;
-
-	WINPR_ASSERT(channel);
-	WINPR_ASSERT(channel->vcm);
-
-	size_t length = Stream_GetPosition(channel->receiveData);
-
-	if ((length < 1) || (length > UINT32_MAX))
-		return FALSE;
-
-	Stream_SetPosition(channel->receiveData, 0);
-	const UINT8 value = Stream_Get_UINT8(channel->receiveData);
-	length--;
-	Cmd = (value & 0xf0) >> 4;
-	Sp = (value & 0x0c) >> 2;
-	cbChId = (value & 0x03) >> 0;
-
-	if (Cmd == CAPABILITY_REQUEST_PDU)
-		return wts_read_drdynvc_capabilities_response(channel, (UINT32)length);
-
-	if (channel->vcm->drdynvc_state == DRDYNVC_STATE_READY)
+	switch (Cmd)
 	{
-		BOOL haveChannelId = 0;
-		switch (Cmd)
-		{
-			case SOFT_SYNC_REQUEST_PDU:
-			case SOFT_SYNC_RESPONSE_PDU:
-				haveChannelId = FALSE;
-				break;
-			default:
-				haveChannelId = TRUE;
-				break;
-		}
+		case CREATE_REQUEST_PDU:
+			return wts_read_drdynvc_create_response(dvc, channel->receiveData, length);
 
-		if (haveChannelId)
-		{
-			const unsigned val = wts_read_variable_uint(channel->receiveData, cbChId, &ChannelId);
-			if (val == 0)
-				return FALSE;
+		case DATA_FIRST_PDU:
+			if (dvc->dvc_open_state != DVC_OPEN_STATE_SUCCEEDED)
+			{
+				WLog_ERR(TAG,
+				         "ChannelId %" PRIu32 " did not open successfully. "
+				         "Ignoring DYNVC_DATA_FIRST PDU",
+				         ChannelId);
+				return TRUE;
+			}
 
-			length -= val;
+			return wts_read_drdynvc_data_first(dvc, channel->receiveData, Sp, length);
 
-			DEBUG_DVC("Cmd %s ChannelId %" PRIu32 " length %" PRIuz "",
-			          drdynvc_get_packet_type(Cmd), ChannelId, length);
-			dvc = wts_get_dvc_channel_by_id(channel->vcm, ChannelId);
-			if (!dvc)
+		case DATA_PDU:
+			if (dvc->dvc_open_state != DVC_OPEN_STATE_SUCCEEDED)
 			{
-				DEBUG_DVC("ChannelId %" PRIu32 " does not exist.", ChannelId);
+				WLog_ERR(TAG,
+				         "ChannelId %" PRIu32 " did not open successfully. "
+				         "Ignoring DYNVC_DATA PDU",
+				         ChannelId);
 				return TRUE;
 			}
-		}
 
-		switch (Cmd)
-		{
-			case CREATE_REQUEST_PDU:
-				return wts_read_drdynvc_create_response(dvc, channel->receiveData, (UINT32)length);
+			return wts_read_drdynvc_data(dvc, channel->receiveData, length);
 
-			case DATA_FIRST_PDU:
-				if (dvc->dvc_open_state != DVC_OPEN_STATE_SUCCEEDED)
-				{
-					WLog_ERR(TAG,
-					         "ChannelId %" PRIu32 " did not open successfully. "
-					         "Ignoring DYNVC_DATA_FIRST PDU",
-					         ChannelId);
-					return TRUE;
-				}
+		case CLOSE_REQUEST_PDU:
+			wts_read_drdynvc_close_response(dvc);
+			break;
 
-				return wts_read_drdynvc_data_first(dvc, channel->receiveData, Sp, (UINT32)length);
+		case DATA_FIRST_COMPRESSED_PDU:
+		case DATA_COMPRESSED_PDU:
+			WLog_ERR(TAG, "Compressed data not handled");
+			break;
 
-			case DATA_PDU:
-				if (dvc->dvc_open_state != DVC_OPEN_STATE_SUCCEEDED)
-				{
-					WLog_ERR(TAG,
-					         "ChannelId %" PRIu32 " did not open successfully. "
-					         "Ignoring DYNVC_DATA PDU",
-					         ChannelId);
-					return TRUE;
-				}
+		case SOFT_SYNC_RESPONSE_PDU:
+			WLog_ERR(TAG, "SoftSync response not handled yet(and rather strange to receive "
+			              "that packet as our code doesn't send SoftSync requests");
+			break;
+
+		case SOFT_SYNC_REQUEST_PDU:
+			WLog_ERR(TAG, "Not expecting a SoftSyncRequest on the server");
+			return FALSE;
 
-				return wts_read_drdynvc_data(dvc, channel->receiveData, (UINT32)length);
+		default:
+			WLog_ERR(TAG, "Cmd %d not recognized.", Cmd);
+			break;
+	}
+	return TRUE;
+}
 
-			case CLOSE_REQUEST_PDU:
-				wts_read_drdynvc_close_response(dvc);
-				break;
+static BOOL wts_read_drdynvc_pdu_ready(rdpPeerChannel* channel, UINT8 Cmd, UINT8 Sp,
+                                       UINT8 cbChId, size_t length)
+{
+	WINPR_ASSERT(channel);
 
-			case DATA_FIRST_COMPRESSED_PDU:
-			case DATA_COMPRESSED_PDU:
-				WLog_ERR(TAG, "Compressed data not handled");
-				break;
+	BOOL haveChannelId = 0;
+	switch (Cmd)
+	{
+		case SOFT_SYNC_REQUEST_PDU:
+		case SOFT_SYNC_RESPONSE_PDU:
+			haveChannelId = FALSE;
+			break;
+		default:
+			haveChannelId = TRUE;
+			break;
+	}
 
-			case SOFT_SYNC_RESPONSE_PDU:
-				WLog_ERR(TAG, "SoftSync response not handled yet(and rather strange to receive "
-				              "that packet as our code doesn't send SoftSync requests");
-				break;
+	UINT32 ChannelId = 0;
+	rdpPeerChannel* dvc = NULL;
+	wHashTable* table = NULL;
+	if (haveChannelId)
+	{
+		const unsigned val = wts_read_variable_uint(channel->receiveData, cbChId, &ChannelId);
+		if (val == 0)
+			return FALSE;
 
-			case SOFT_SYNC_REQUEST_PDU:
-				WLog_ERR(TAG, "Not expecting a SoftSyncRequest on the server");
-				return FALSE;
+		length -= val;
 
-			default:
-				WLog_ERR(TAG, "Cmd %d not recognized.", Cmd);
-				break;
+		DEBUG_DVC("Cmd %s ChannelId %" PRIu32 " length %" PRIuz "",
+		          drdynvc_get_packet_type(Cmd), ChannelId, length);
+		table = channel->vcm->dynamicVirtualChannels;
+		if (!table)
+			return FALSE;
+		HashTable_Lock(table);
+		dvc = wts_get_dvc_channel_by_id(channel->vcm, ChannelId);
+		if (!dvc)
+		{
+			DEBUG_DVC("ChannelId %" PRIu32 " does not exist.", ChannelId);
+			HashTable_Unlock(table);
+			return TRUE;
 		}
 	}
+
+	const BOOL rc = wts_read_drdynvc_pdu_ready_guarded(channel, Cmd, Sp, ChannelId, dvc,
+	                                                   (UINT32)length);
+	if (table)
+		HashTable_Unlock(table);
+	return rc;
+}
+
+static BOOL wts_read_drdynvc_pdu(rdpPeerChannel* channel)
+{
+	WINPR_ASSERT(channel);
+	WINPR_ASSERT(channel->vcm);
+
+	size_t length = Stream_GetPosition(channel->receiveData);
+
+	if ((length < 1) || (length > UINT32_MAX))
+		return FALSE;
+
+	Stream_SetPosition(channel->receiveData, 0);
+	const UINT8 value = Stream_Get_UINT8(channel->receiveData);
+	length--;
+	const UINT8 Cmd = (value & 0xf0) >> 4;
+	const UINT8 Sp = (value & 0x0c) >> 2;
+	const UINT8 cbChId = (value & 0x03) >> 0;
+
+	if (Cmd == CAPABILITY_REQUEST_PDU)
+		return wts_read_drdynvc_capabilities_response(channel, (UINT32)length);
+
+	if (channel->vcm->drdynvc_state == DRDYNVC_STATE_READY)
+		return wts_read_drdynvc_pdu_ready(channel, Cmd, Sp, cbChId, length);
 	else
-	{
 		WLog_ERR(TAG, "received Cmd %d but channel is not ready.", Cmd);
-	}
 
 	return TRUE;
 }
