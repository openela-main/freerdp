---
 libfreerdp/core/rdstls.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/libfreerdp/core/rdstls.c b/libfreerdp/core/rdstls.c
index fff802a81c..911e8cdf68 100644
--- a/libfreerdp/core/rdstls.c
+++ b/libfreerdp/core/rdstls.c
@@ -776,5 +776,6 @@ static BOOL rdstls_process_authentication_request_with_cookie(rdpRdstls* rdstls,
 
 	WLog_Print(rdstls->log, WLOG_DEBUG, "RDSTLS Cookie matches. Grant access.");
-	return FALSE;
+	rdstls->resultCode = RDSTLS_RESULT_SUCCESS;
+	return TRUE;
 }
 
