From d4dd0d4e4b36f3f4c3f89f24bcf687de5598bd81 Mon Sep 17 00:00:00 2001
From: Ondrej Holy <oholy@redhat.com>
Date: Tue, 27 Oct 2026 10:00:00 +0000
Subject: [PATCH] [winpr,sspi] fix ntlm_computeMicValue input validation

Backport of commit 52ffa3ca8cbdabaef6d1224de77dd18b604fd1f3.

Adapted for 2.11.x: keeps C89 declarations at the top of the function,
`BYTE*`/`ULONG` style and a plain `(ULONG)` cast instead of
`WINPR_ASSERTING_INT_CAST`. All upstream guards are preserved.
---
 winpr/libwinpr/sspi/NTLM/ntlm.c | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/winpr/libwinpr/sspi/NTLM/ntlm.c b/winpr/libwinpr/sspi/NTLM/ntlm.c
index 0e12a3429..1f58f925e 100644
--- a/winpr/libwinpr/sspi/NTLM/ntlm.c
+++ b/winpr/libwinpr/sspi/NTLM/ntlm.c
@@ -717,18 +717,28 @@ SECURITY_STATUS ntlm_computeProofValue(NTLM_CONTEXT* ntlm, SecBuffer* ntproof)
 SECURITY_STATUS ntlm_computeMicValue(NTLM_CONTEXT* ntlm, SecBuffer* micvalue)
 {
 	BYTE* blob;
-	ULONG msgSize;
+	UINT64 msgSize;
 
 	WINPR_ASSERT(ntlm);
 	WINPR_ASSERT(micvalue);
 
-	msgSize = ntlm->NegotiateMessage.cbBuffer + ntlm->ChallengeMessage.cbBuffer +
-	          ntlm->AuthenticateMessage.cbBuffer;
+	msgSize = 1ull * ntlm->NegotiateMessage.cbBuffer +
+	          ntlm->ChallengeMessage.cbBuffer + ntlm->AuthenticateMessage.cbBuffer;
+	if (msgSize > UINT32_MAX)
+		return SEC_E_INSUFFICIENT_MEMORY;
 
-	if (!sspi_SecBufferAlloc(micvalue, msgSize))
+	if (!sspi_SecBufferAlloc(micvalue, (ULONG)msgSize))
 		return SEC_E_INSUFFICIENT_MEMORY;
 
+	if (micvalue->cbBuffer < msgSize)
+		return SEC_E_INVALID_TOKEN;
+	if (ntlm->AuthenticateMessage.cbBuffer < ntlm->MessageIntegrityCheckOffset + 16ull)
+		return SEC_E_INVALID_TOKEN;
+
 	blob = (BYTE*)micvalue->pvBuffer;
+	if (!blob)
+		return SEC_E_INVALID_TOKEN;
+
 	CopyMemory(blob, ntlm->NegotiateMessage.pvBuffer, ntlm->NegotiateMessage.cbBuffer);
 	blob += ntlm->NegotiateMessage.cbBuffer;
 	CopyMemory(blob, ntlm->ChallengeMessage.pvBuffer, ntlm->ChallengeMessage.cbBuffer);
